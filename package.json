{
  "name": "vue-verona-components",
  "version": "0.1.0",
  "description": "Vue 3 component for hosting Verona players and handling the host side of the Verona player interface",
  "keywords": [
    "vue",
    "vue3",
    "verona",
    "verona-player"
  ],
  "homepage": "https://github.com/kompetenztestde/vue-verona-components#readme",
  "bugs": {
    "url": "https://github.com/kompetenztestde/vue-verona-components/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kompetenztestde/vue-verona-components.git"
  },
  "license": "MIT",
  "author": "kompetenztest.de",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/vue-verona-components.umd.cjs",
  "module": "./dist/vue-verona-components.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-verona-components.js",
      "require": "./dist/vue-verona-components.umd.cjs"
    },
    "./style.css": "./dist/vue-verona-components.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write src/",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "unplugin-dts": "^1.1.2",
    "vite": "^8.3.0",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
